{
  "code_actions_on_format": {
    "source.organizeImports.oxc": true,
    "source.fixAll.oxc": true
  },
  "format_on_save": "on",
  "formatter": "language_server",
  "lsp": {
    "typescript-language-server": {
      "settings": {
        "typescript": {
          "preferences": {
            "includePackageJsonAutoImports": "on"
          }
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "flags": {},
          "fmt.configPath": null,
          "fmt.experimental": true,
          "run": "onSave",
          "typeAware": false,
          "unusedDisableDirectives": false
        }
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "run": "onType",
          "typeAware": true,
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "vtsls": {
      "settings": {
        "javascript": {
          "preferences": {
            "includePackageJsonAutoImports": "on"
          }
        },
        "typescript": {
          "preferences": {
            "includePackageJsonAutoImports": "on"
          }
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["typescript-ls", "vtsls", "!typescript-language-server"],
      "semantic_tokens": "combined"
    },
    "JSON": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "prettier": {
        "allowed": false
      }
    },
    "JSONC": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "prettier": {
        "allowed": false
      }
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["typescript-ls", "vtsls", "!typescript-language-server"],
      "semantic_tokens": "combined"
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["typescript-ls", "vtsls", "oxlint", "!typescript-language-server"],
      "semantic_tokens": "combined"
    },
    "YAML": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  }
}
