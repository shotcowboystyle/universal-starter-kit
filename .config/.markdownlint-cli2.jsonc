{
  "config": {
    // Disable line length
    "MD013": false,
    // Allow inline HTML
    "MD033": false,
    // Allow bare URLs
    "MD034": false,
    // Allow duplicate headings in different sections
    "MD024": {
      "siblings_only": true
    }
  },
  "ignores": [
    "**/node_modules",
    "dist",
    ".next",
    "storybook-static",
    "coverage",
    "ai_docs/**",
    ".claude/**",
    "**/CLAUDE.md",
    "**/AGENTS.md",
    "**/TO-DOS.md",
    "**/PLAN.md"
  ]
}
