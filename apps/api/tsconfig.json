{
  "extends": "@repo/config/tsconfig/app.json",
  "compilerOptions": {
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    // Nest DTOs/schemas are populated by decorators, not constructors.
    "strictPropertyInitialization": false,
    "noFallthroughCasesInSwitch": false,
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["dist", "**/*spec.ts", "database/mongodb/**/*", "__tests__"]
}
