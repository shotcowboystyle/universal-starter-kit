{
  "name": "@repo/platform",
  "version": "0.0.0",
  "private": true,
  "description": "Platform detection flags and utilities for universal starter kit",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    "./rnw-overrides": {
      "types": "./src/rnw_overrides.d.ts"
    },
    "./file": {
      "types": "./src/file/index.ts",
      "default": "./src/file/index.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "format": "cd ../.. && oxfmt --no-error-on-unmatched-pattern --config .config/oxfmtrc.json packages/platform",
    "lint": "npx oxlint --config ../../.config/oxlintrc.json --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@tamagui/constants": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@repo/test-utils": "workspace:*",
    "@types/chrome": "^0.1.40",
    "@types/firefox-webext-browser": "^143.0.0",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "expo-file-system": "55.0.26",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "expo-constants": "~55.0.15",
    "expo-file-system": "~55.0.26",
    "react": "^19.1.0",
    "react-native": ">=0.83.0"
  },
  "peerDependenciesMeta": {
    "expo-constants": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
