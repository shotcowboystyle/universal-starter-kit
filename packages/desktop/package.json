{
  "name": "@repo/desktop",
  "version": "0.0.0",
  "description": "Desktop platform APIs (Tauri) for universal-starter-kit",
  "license": "Apache-2.0",
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "!types/.tsbuildinfo"
  ],
  "sideEffects": false,
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "source": "./src/index.ts",
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf types 2>/dev/null && tsc -p tsconfig.build.json",
    "test": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=html",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    },
    "@tauri-apps/plugin-dialog": {
      "optional": true
    },
    "@tauri-apps/plugin-fs": {
      "optional": true
    },
    "@tauri-apps/plugin-updater": {
      "optional": true
    }
  }
}
