{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./css/code-highlight.css": {
      "import": "./css/code-highlight.css",
      "require": "./css/code-highlight.css"
    }
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "format": "cd ../.. && oxfmt --no-error-on-unmatched-pattern --config .config/oxfmtrc.json packages/ui",
    "lint": "npx oxlint --config ../../.config/oxlintrc.json --fix",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "start-server-and-test storybook http://127.0.0.1:6006 \"pnpm exec test-storybook\"",
    "test": "vitest run"
  },
  "dependencies": {
