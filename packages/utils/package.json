{
  "name": "@repo/utils",
  "version": "0.0.0",
  "private": true,
  "description": "utilities for universal starter kit",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./dev": {
      "types": "./src/dev.ts",
      "default": "./src/dev.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "format": "cd ../.. && oxfmt --no-error-on-unmatched-pattern --config .config/oxfmtrc.json packages/utils",
    "lint": "npx oxlint --config ../../.config/oxlintrc.json --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "mysql2": "^3.15.3",
    "pg": "^8.20.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
