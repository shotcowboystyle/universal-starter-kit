{
  "name": "@repo/vite-plugin-webext",
  "version": "0.0.0",
  "description": "Vite config factories for building a browser web extension (MV3 views, background service worker, content scripts) as a target of a universal-starter-kit One app — workspace source aliases, the one-server-only browser stub, Tamagui wiring, and the manifest/dev-reload prepare pipeline.",
  "license": "Apache-2.0",
  "source": "src/index.ts",
  "files": [
    "lib",
    "types",
    "src",
    "!types/.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./types/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf lib types 2>/dev/null && tsgo --noEmit && tsdown",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@repo/utils": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@tamagui/vite-plugin": "catalog:",
    "@types/babel__core": "^7.20.5",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@tamagui/vite-plugin": "*",
    "@vitejs/plugin-react": ">=4",
    "vite": ">=5"
  }
}
