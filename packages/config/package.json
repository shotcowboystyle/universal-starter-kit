{
  "name": "@repo/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared build and test configuration presets for universal starter kit",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./storybook": {
      "types": "./src/storybook.ts",
      "default": "./src/storybook.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./vitest": {
      "types": "./src/vitest.ts",
      "default": "./src/vitest.ts"
    },
    "./playwright": {
      "types": "./src/playwright.ts",
      "default": "./src/playwright.ts"
    },
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/build.json": "./tsconfig/build.json",
    "./tsconfig/app.json": "./tsconfig/app.json",
    "./react-native-config": "./src/react-native.config.cjs",
    "./oxlint": "./oxlint.mjs",
    "./oxlint.json": "./oxlint.json",
    "./drawingRegistry": "./drawingRegistry.mjs",
    "./specRegistry": "./specRegistry.mjs",
    "./lint": {
      "types": "./lint.d.ts",
      "default": "./lint.mjs"
    }
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "format": "cd ../.. && oxfmt --no-error-on-unmatched-pattern --config .config/oxfmtrc.json packages/config",
    "lint": "npx oxlint --config ../../.config/oxlintrc.json --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/utils": "workspace:*",
    "@tamagui/vite-plugin": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "dotenv": "catalog:",
    "vite": "catalog:",
    "vite-plugin-external": "^6.2.2",
    "vite-plugin-i18next-loader": "^3.1.3",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.20.0",
    "one": "^1.4.10",
    "react-native": ">=0.83.0",
    "vxrn": "^1.4.10"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "one": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "vxrn": {
      "optional": true
    }
  }
}
