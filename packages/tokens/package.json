{
  "name": "@repo/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./base": "./src/base.json",
    "./theme/*": "./src/theme/*.json"
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "format": "cd ../.. && oxfmt --no-error-on-unmatched-pattern --config .config/oxfmtrc.json packages/tokens",
    "lint": "npx oxlint --config ../../.config/oxlintrc.json --fix"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
