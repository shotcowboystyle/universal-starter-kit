{
  "name": "@repo/frappe-ui",
  "version": "0.0.0",
  "description": "Pre-wired Tamagui components for Frappe doctypes with live data",
  "license": "Apache-2.0",
  "source": "src/index.ts",
  "files": [
    "dist",
    "src",
    "types",
    "!types/.tsbuildinfo"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    ".": {
      "source": "./src/index.ts",
      "types": "./types/index.d.ts",
      "react-native": {
        "types": "./types/index.d.ts",
        "import": "./dist/esm/index.native.js",
        "require": "./dist/cjs/index.native.js"
      },
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./dependsOn": {
      "source": "./src/dependsOn.ts",
      "types": "./types/dependsOn.d.ts",
      "import": "./dist/esm/dependsOn.mjs",
      "require": "./dist/cjs/dependsOn.cjs",
      "default": "./src/dependsOn.ts"
    },
    "./formActions": {
      "source": "./src/formEngine/formActions.ts",
      "types": "./types/formEngine/formActions.d.ts",
      "import": "./dist/esm/formEngine/formActions.mjs",
      "require": "./dist/cjs/formEngine/formActions.cjs",
      "default": "./src/formEngine/formActions.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist types 2>/dev/null && tamagui-build --ts-project ./tsconfig.build.json --exclude '\\.spec\\.|\\.test\\.|\\.stories\\.'",
    "test": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=html",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "catalog:",
    "@repo/desktop": "workspace:*",
    "@repo/forms": "workspace:*",
    "@repo/frappe": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/markdown": "workspace:*",
    "@repo/platform": "workspace:*",
    "@repo/rich-text": "workspace:*",
    "@repo/router": "workspace:*",
    "@repo/store": "workspace:*",
    "@repo/table": "workspace:*",
    "@repo/theme": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tamagui/colors": "catalog:",
    "@tanstack/db": "0.8.0",
    "@tanstack/form-core": "^1.29.1",
    "@tanstack/react-hotkeys": "^0.5.1",
    "@tiptap/extension-image": "^3.30.0",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/extension-placeholder": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "html5-qrcode": "^2.3.8",
    "signature_pad": "^5.1.3",
    "tamagui": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@repo/storybook": "workspace:*",
    "@repo/test-utils": "workspace:*",
    "@tamagui/build": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@react-native-community/datetimepicker": ">=8.0.1",
    "i18next": "^25.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": ">=14",
    "react-native": ">=0.83.0",
    "react-native-safe-area-context": "*"
  },
  "peerDependenciesMeta": {
    "@react-native-community/datetimepicker": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "module:jsx": "dist/jsx"
}
