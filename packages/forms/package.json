    "@repo/theme": "workspace:*",
    "@tamagui/get-font-sized": "catalog:",
    "@tamagui/get-token": "catalog:",
    "@tamagui/lucide-icons-2": "catalog:",
    "@tamagui/roving-focus": "catalog:",
    "@tamagui/stacks": "catalog:",
