{
  "name": "@repo/router",
  "version": "0.0.0",
  "private": true,
  "description": "Router with support for react-router-dom and react-navigation",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./seam": {
      "types": "./src/seam/index.ts",
      "default": "./src/seam/index.ts"
    }
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "format": "cd ../.. && oxfmt --no-error-on-unmatched-pattern --config .config/oxfmtrc.json packages/router",
    "lint": "npx oxlint --config ../../.config/oxlintrc.json --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/platform": "workspace:*",
    "@vxrn/color-scheme": "catalog:"
  },
  "devDependencies": {
    "@react-navigation/native": "catalog:",
    "@repo/config": "workspace:*",
    "@repo/test-utils": "workspace:*",
    "@testing-library/react": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "next": "16.2.4",
    "one": "^1.16.5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-router-dom": "^7.14.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@react-navigation/native": "~7.2.2",
    "one": "^1.4.10",
    "react": "^19.1.0",
    "react-router-dom": "^7.0.0",
    "next": ">=15"
  },
  "module:jsx": "dist/jsx",
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
