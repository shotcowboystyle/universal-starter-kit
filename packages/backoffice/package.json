{
  "name": "@repo/backoffice",
  "version": "0.0.0",
  "description": "Embeddable Frappe desk recreation (backoffice) for the universal-starter-kit stack",
  "license": "Apache-2.0",
  "source": "src/index.ts",
  "files": [
    "dist",
    "src",
    "types",
    "!types/.tsbuildinfo"
  ],
  "sideEffects": [
    "**/*.css",
    "src/**"
  ],
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    ".": {
      "source": "./src/index.ts",
      "types": "./types/index.d.ts",
      "react-native": {
        "types": "./types/index.d.ts",
        "import": "./dist/esm/index.native.js",
        "require": "./dist/cjs/index.native.js"
      },
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./one-adapter": {
      "source": "./src/oneAdapter/index.tsx",
      "types": "./types/oneAdapter/index.d.ts",
      "react-native": {
        "types": "./types/oneAdapter/index.d.ts",
        "import": "./dist/esm/oneAdapter/index.native.js",
        "require": "./dist/cjs/oneAdapter/index.native.js"
      },
      "import": "./dist/esm/oneAdapter/index.mjs",
      "require": "./dist/cjs/oneAdapter/index.cjs",
      "default": "./dist/esm/oneAdapter/index.mjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist types 2>/dev/null && tamagui-build --ts-project ./tsconfig.build.json --exclude '\\.spec\\.|\\.test\\.|\\.stories\\.'",
    "test": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=html",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "catalog:",
    "@repo/forms": "workspace:*",
    "@repo/frappe": "workspace:*",
    "@repo/frappe-ui": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/platform": "workspace:*",
    "@repo/store": "workspace:*",
    "@repo/table": "workspace:*",
    "@repo/theme": "workspace:*",
    "@repo/ui": "workspace:*",
    "tamagui": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@repo/test-utils": "workspace:*",
    "@tamagui/build": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "i18next": "catalog:",
    "one": "^1.16.5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "i18next": "^25.0.0",
    "one": "^1.4.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": ">=14",
    "react-native": ">=0.83.0"
  },
  "peerDependenciesMeta": {
    "one": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "module:jsx": "dist/jsx"
}
