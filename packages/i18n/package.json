{
  "name": "@repo/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Internationalization utilities and hooks for universal starter kit",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "format": "cd ../.. && oxfmt --no-error-on-unmatched-pattern --config .config/oxfmtrc.json packages/i18n",
    "lint": "npx oxlint --config ../../.config/oxlintrc.json --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/platform": "workspace:*"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@repo/test-utils": "workspace:*",
    "@typescript/native-preview": "catalog:",
    "happy-dom": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "i18next": "^25.0.0",
    "react": "^19.1.0"
  }
}
