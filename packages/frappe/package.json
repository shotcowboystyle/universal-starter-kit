{
  "name": "@repo/frappe",
  "version": "0.0.0",
  "description": "frappe client for universal starter ket ecosystem",
  "license": "Apache-2.0",
  "source": "src/index.ts",
  "files": [
    "dist",
    "src",
    "types",
    "!types/.tsbuildinfo"
  ],
  "sideEffects": false,
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "source": "./src/index.ts",
      "react-native": {
        "types": "./types/index.d.ts",
        "import": "./dist/esm/index.native.js",
        "require": "./dist/cjs/index.native.js",
        "default": "./dist/esm/index.native.js"
      },
      "types": "./types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/cjs/index.cjs"
    },
    "./devtools": {
      "source": "./src/devtools/index.ts",
      "types": "./types/devtools/index.d.ts",
      "import": "./dist/esm/devtools/index.mjs",
      "require": "./dist/cjs/devtools/index.cjs",
      "default": "./src/devtools/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist types 2>/dev/null && tamagui-build --ts-project ./tsconfig.build.json --exclude '\\.spec\\.|\\.test\\.|\\.stories\\.'",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@repo/store": "workspace:*",
    "@tanstack/db": "0.8.0",
    "@tanstack/pacer": "0.21.0",
    "@tanstack/react-db": "0.3.0",
    "@tanstack/react-pacer": "0.22.0",
    "broadcast-channel": "^7.3.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@repo/platform": "workspace:*",
    "@repo/test-utils": "workspace:*",
    "@tamagui/build": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash.camelcase": "^4.3.9",
    "@types/lodash.startcase": "^4.4.9",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "tamagui": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@repo/platform": "^0.0.0",
    "react": "^19.1.0"
  },
  "engines": {
    "node": ">=6.0.0"
  },
  "module:jsx": "dist/jsx"
}
