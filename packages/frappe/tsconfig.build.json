{
  "extends": "@repo/config/tsconfig/build.json",
  // Paths are restated here: relative paths in the extended build.json resolve
  // against packages/config/tsconfig/, and tamagui-build's TypeScript has no
  // ${configDir}.
  "compilerOptions": {
    "baseUrl": "./",
    "rootDir": "./",
    "outDir": "dist",
    "declarationDir": "types",
    "tsBuildInfoFile": "types/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": [
    "dist/**/*",
    "node_modules/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ]
}
