{
  "name": "@repo/test-utils",
  "version": "0.0.0",
  "private": true,
  "description": "Shared testing utilities for universal starter kit packages",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./setup": {
      "types": "./src/setup.ts",
      "default": "./src/setup.ts"
    },
    "./mocks": {
      "types": "./src/mocks.ts",
      "default": "./src/mocks.ts"
    }
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "format": "cd ../.. && oxfmt --no-error-on-unmatched-pattern --config .config/oxfmtrc.json packages/test-utils",
    "lint": "npx oxlint --config ../../.config/oxlintrc.json --fix"
  },
  "dependencies": {
    "@floating-ui/react": "catalog:",
    "@repo/theme": "workspace:*",
    "@tamagui/config": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "matchmedia-polyfill": "catalog:",
    "tamagui": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@typescript/native-preview": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vitest": "^4.0.0"
  }
}
