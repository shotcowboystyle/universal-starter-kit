{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "ENABLE_EXPERIMENTAL_COREPACK"],
  "globalDependencies": ["packages/config/*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    "storybook": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{ts,tsx,js,jsx}", ".storybook/**/*"]
    },
    "storybook:build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "storybook:test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "inputs": ["src/**/*.{ts,tsx,js,jsx}", "__tests__/**/*.{ts,tsx,js,jsx}"],
      "outputs": ["coverage/**"]
    },
    "playwright": {
      "inputs": ["src/**/*.{ts,tsx,js,jsx}", "__tests__/**/*.{ts,tsx,js,jsx}"],
      "cache": false
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "spellcheck": {
      "inputs": ["**/*.{ts,tsx,js,jsx,md,json}", "../../.config/cspell.json"]
    },
    "init-db": {
      "env": ["DATABASE_URL"],
      "cache": false,
      "dependsOn": ["^build"]
    },
    "init-db:force": {
      "env": ["DATABASE_URL"],
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
